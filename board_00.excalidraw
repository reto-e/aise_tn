      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145681588,
      "link": null,
      "locked": false,
      "text": "| Workshop owner / business owner | Run a profitable workshop, monitor revenue,\ncontrol operations, manage staff, protect customer data, and configure company\nbranding. | High | Poor adoption, lost revenue visibility, weak governance, and\nreduced confidence in the platform. |",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Workshop owner / business owner | Run a profitable workshop, monitor revenue, control operations, manage staff, protect customer data, and configure company branding. | High | Poor adoption, lost revenue visibility, weak governance, and reduced confidence in the platform. |",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aN_cbonYa-obluop865CA",
      "type": "text",
      "x": -2961.4143719213207,
      "y": 2459.269633689905,
      "width": 781.099365234375,
      "height": 100,
