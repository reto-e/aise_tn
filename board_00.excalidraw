      "versionNonce": 925698531,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145690779,
      "link": null,
      "locked": false,
      "text": "1. **Establish a Stakeholder Board** - Monthly sync with Owner, Bookkeeper,\nTechnician leads, and Customer representative",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. **Establish a Stakeholder Board** - Monthly sync with Owner, Bookkeeper, Technician leads, and Customer representative",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
