      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIJ",
      "roundness": null,
      "seed": 354484515,
      "version": 40,
      "versionNonce": 1701525965,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145690779,
      "link": null,
      "locked": false,
      "text": "2. **Create Feedback Channels** - Regular surveys, feature requests, issue\nreporting from each stakeholder group",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. **Create Feedback Channels** - Regular surveys, feature requests, issue reporting from each stakeholder group",
