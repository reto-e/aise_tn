      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145681588,
      "link": null,
      "locked": false,
      "text": "| Parts / inventory coordinator | Maintain part stock, supplier information, low-\nstock alerts, markup, and parts used on work orders. | Medium | Stockouts, over-\nordering, incorrect margins, and delayed repairs. |",
      "fontSize": 20,
      "fontFamily": 5,
