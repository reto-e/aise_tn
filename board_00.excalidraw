      "versionNonce": 834687821,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145690779,
      "link": null,
      "locked": false,
      "text": "This document identifies and analyzes all stakeholders in the Torqvoice\necosystem, including internal workshop staff, customers, vendors, and system\nadministrators.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This document identifies and analyzes all stakeholders in the Torqvoice ecosystem, including internal workshop staff, customers, vendors, and system administrators.",
