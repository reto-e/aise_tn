      "versionNonce": 1876194557,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145681588,
      "link": null,
      "locked": false,
      "text": "| Service advisor | Create customer-facing quotes, explain service work, update\nstatuses, send invoices, and communicate through email, SMS, or Telegram. | High |\nCustomers receive unclear or late information, quote approvals slow down, and\nservice handovers become error-prone. |",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Service advisor | Create customer-facing quotes, explain service work, update statuses, send invoices, and communicate through email, SMS, or Telegram. | High | Customers receive unclear or late information, quote approvals slow down, and service handovers become error-prone. |",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "RVExNxhLyTcaOYEO04rVx",
