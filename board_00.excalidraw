      "versionNonce": 378409907,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145681588,
      "link": null,
      "locked": false,
      "text": "| Workshop manager / admin | Coordinate daily work, manage customers, vehicles,\nwork orders, quotes, invoices, payments, inventory, and reports. | High |\nOperational delays, duplicate work, inaccurate records, and missed customer\ncommitments. |",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Workshop manager / admin | Coordinate daily work, manage customers, vehicles, work orders, quotes, invoices, payments, inventory, and reports. | High | Operational delays, duplicate work, inaccurate records, and missed customer commitments. |",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "GhPhmkWGVqyXtq4lIRCPL",
      "type": "text",
      "x": -2969.914432956477,
      "y": 2569.269633689905,
      "width": 798.0994873046875,
      "height": 100,
