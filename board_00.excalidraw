      "isDeleted": true,
      "boundElements": [],
      "updated": 1778145681588,
      "link": null,
      "locked": false,
      "text": "| Technician | View assigned jobs, update work order progress, record inspections,\nfindings, labor, parts, notes, and attachments. | High | Work quality and\ntraceability suffer, jobs are delayed, and billing may miss labor or parts. |",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
