    },
    {
      "id": "e-i34dcIfHUkjydugq-Jg",
      "type": "text",
      "x": 3853.221082956089,
      "y": 8133.905515673677,
      "width": 757.2994995117188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
