    {
      "id": "AnQ2S3oouZ2pcTYsLYbz7",
      "type": "text",
      "x": -1123.6174475810967,
      "y": 5257.239719722686,
      "width": 1100,
      "height": 80,
      "text": "KEY RELATIONSHIPS:\n• Technicians and Managers operate through the unified web UI with role-based access control\n• Customers access their service records through the portal with magic-link authentication\n• External systems integrate via webhooks and APIs (bidirectional event flow)\n• All data isolated per organization (multi-tenancy) with 60+ Prisma models\n• Real-time updates via WebSocket connections for status changes and notifications",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KEY RELATIONSHIPS:\n• Technicians and Managers operate through the unified web UI with role-based access control\n• Customers access their service records through the portal with magic-link authentication\n• External systems integrate via webhooks and APIs (bidirectional event flow)\n• All data isolated per organization (multi-tenancy) with 60+ Prisma models\n• Real-time updates via WebSocket connections for status changes and notifications",
      "autoResize": true,
      "lineHeight": 1.25,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "#f5f5f5",
      "fillStyle": "solid",
      "strokeWidth": 1,
